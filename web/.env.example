# Next.js loads envs from:
# - .env.local (local overrides, not committed)
# - .env.development(.local)
# - .env.production(.local)
#
# Use NEXT_PUBLIC_* for browser-available keys.

# Supabase (DEV)
NEXT_PUBLIC_SUPABASE_URL=https://<your-dev-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-dev-anon-key>

# Feature toggles (optional)
# NEXT_PUBLIC_USE_CHANGE_STAGE_RPC=true
# Enable demo I.A parecer block in EditarFicha (only for Empresa LTDA)
# NEXT_PUBLIC_DEMO_IA_PARECER=1

# Kanban auto-archive TTL (seconds)
# Cards em 'Finalizados' serão arquivados automaticamente após este tempo.
# Em produção, ajuste conforme sua necessidade. Padrão: 60
# NEXT_PUBLIC_FINALIZADOS_TTL_SEC=60
